+/** Human-facing Schedule management values; durable records keep their existing v1 format. */
+
+import type { ScheduleId, ScheduleRecord } from './types.ts'
+
+/** Exactly one supported reminder rule supplied by a client. */
+export type ScheduleInput =
+  | { readonly kind: 'after'; readonly prompt: string; readonly afterSeconds: number }
+  | { readonly kind: 'at'; readonly prompt: string; readonly scheduledAt: string }
+  | { readonly kind: 'every'; readonly prompt: string; readonly everySeconds: number }
+
+/** Operations exposed while the Schedule plugin is loaded. */
+export interface ScheduleCapabilities {
+  readonly create: boolean
+  readonly update: boolean
+  readonly delete: boolean
+  readonly pause: false
+}
+
+/** Human mutation result, including retained replacement records after an incomplete edit. */
+export type ScheduleMutationResult =
+  | { readonly ok: true; readonly item: ScheduleRecord; readonly replacedId?: ScheduleId }
+  | { readonly ok: true; readonly deletedId: ScheduleId }
+  | {
+    readonly ok: false
+    readonly code: string
+    readonly message: string
+    /** Appended replacement identity; read the current list before retrying an uncertain operation. */
+    readonly replacement?: ScheduleRecord
+    readonly originalId?: ScheduleId
+  }
