+/** Session-owned human Schedule mutations sharing the timer/tool transaction queue. */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { Remote, TypertRemoteService } from '@deepseek-ai/dsh-typert-protocol'
+import { assertNever } from '@deepseek-ai/dsh-util-values'
+import {
+  allocateScheduleId, createAfterScheduleRecord, createAtScheduleRecord, createEveryScheduleRecord,
+  foldScheduleEvents, ScheduleInputError, ScheduleLogError,
+} from './domain.ts'
+import { flushSchedulePersistence } from './persistence.ts'
+import { runScheduleTransaction } from './transaction.ts'
+import type { ScheduleCapabilities, ScheduleInput, ScheduleMutationResult } from './management-types.ts'
+import type { ScheduleId, ScheduleRecord } from './types.ts'
+
+type Failure = Extract<ScheduleMutationResult, { ok: false }>
+
+/** Read-only availability and explicit human mutations for this plugin's exact live root Agents. */
+export class ScheduleManagement extends TypertRemoteService {
+  private readonly pending = new Set<Promise<ScheduleMutationResult>>()
+
+  /**
+   * Bind the Remote to the plugin's runtime owner map.
+   * @param ctx - Plugin context owning durability and this service's lifetime.
+   * @param owner - Resolve the exact live owner's timer notification, or undefined after release.
+   */
+  constructor(ctx: Context, private readonly owner: (agent: Agent) => (() => void) | undefined) {
+    super(ctx, 'schedules')
+    ctx.effect(() => async () => { await Promise.allSettled(this.pending) }, 'schedule.management()')
+  }
+
+  /**
+   * Describe human operations while this Schedule plugin is loaded.
+   * @returns Supported operations without opening, resuming, or creating a Session.
+   */
+  @Remote
+  capabilities(): ScheduleCapabilities {
+    return { create: true, update: true, delete: true, pause: false }
+  }
+
+  /**
+   * Create and durably confirm one reminder in the resolved root Agent's Session.
+   * @param agent - Exact Agent resolved by the existing Session lookup.
+   * @param input - One explicit reminder rule.
+   * @param signal - Remote cancellation; checked before appending.
+   * @returns The confirmed record or a contained error with any uncertain appended identity.
+   */
+  @Remote
+  create(agent: Agent, input: ScheduleInput, signal: AbortSignal): Promise<ScheduleMutationResult> {
+    return this.run(agent, signal, () => this.save(agent, input, signal))
+  }
+
+  /**
+   * Save a confirmed new record before retiring the old one, under one Schedule transaction.
+   * @param agent - Exact Agent resolved by the existing Session lookup.
+   * @param id - Current Session-local reminder identity.
+   * @param input - Replacement reminder rule.
+   * @param signal - Remote cancellation; checked before each append.
+   * @returns The replacement or an error identifying retained or uncertain replacement work.
+   */
+  @Remote
+  update(agent: Agent, id: ScheduleId, input: ScheduleInput, signal: AbortSignal): Promise<ScheduleMutationResult> {
+    return this.run(agent, signal, () => this.save(agent, input, signal, id))
+  }
+
+  /**
+   * Delete one active reminder after validating ownership and flushing its Session.
+   * @param agent - Exact Agent resolved by the existing Session lookup.
+   * @param id - Current Session-local reminder identity.
+   * @param signal - Remote cancellation; checked before appending.
+   * @returns The confirmed deletion or a contained error; unknown ids do not mutate the log.
+   */
+  @Remote('delete')
+  remove(agent: Agent, id: ScheduleId, signal: AbortSignal): Promise<ScheduleMutationResult> {
+    return this.run(agent, signal, async () => {
+      if (!await this.flush(agent)) return this.uncertain()
+      const invalid = this.unavailable(agent, signal)
+      if (invalid !== undefined) return invalid
+      const folded = this.fold(agent)
+      if ('ok' in folded) return folded
+      if (!folded.active.some(record => record.id === id)) return this.notFound()
+      agent.session.append('schedule/change', { version: 1, operation: 'delete', id })
+      if (!await this.flush(agent)) return this.uncertain()
+      this.notify(agent)
+      return { ok: true, deletedId: id }
+    })
+  }
+
+  private async save(agent: Agent, input: ScheduleInput, signal: AbortSignal, originalId?: ScheduleId): Promise<ScheduleMutationResult> {
+    if (!await this.flush(agent)) return this.uncertain()
+    const invalid = this.unavailable(agent, signal)
+    if (invalid !== undefined) return invalid
+    const folded = this.fold(agent)
+    if ('ok' in folded) return folded
+    if (originalId !== undefined && !folded.active.some(record => record.id === originalId)) return this.notFound()
+    const id = allocateScheduleId(folded)
+    let replacement: ScheduleRecord
+    try {
+      const now = Date.now()
+      switch (input.kind) {
+        case 'after': replacement = createAfterScheduleRecord(id, input.prompt, input.afterSeconds, now); break
+        case 'at': replacement = createAtScheduleRecord(id, input.prompt, input.scheduledAt, now); break
+        case 'every': replacement = createEveryScheduleRecord(id, input.prompt, input.everySeconds, now); break
+        default: return assertNever(input, 'Schedule input')
+      }
+    } catch (error) {
+      if (error instanceof ScheduleInputError) return { ok: false, code: error.code, message: error.message }
+      throw error
+    }
+    agent.session.append('schedule/change', { version: 1, operation: 'create', schedule: replacement })
+    if (!await this.flush(agent)) return { ...this.uncertain(), replacement, ...originalId === undefined ? {} : { originalId } }
+    this.notify(agent)
+    if (originalId === undefined) return { ok: true, item: replacement }
+
+    // The new record is durable before the old record can be removed.
+    const cancelled = this.unavailable(agent, signal)
+    if (cancelled !== undefined) return { ...cancelled, replacement, originalId }
+    try {
+      agent.session.append('schedule/change', { version: 1, operation: 'delete', id: originalId })
+    } catch {
+      return { ok: false, code: 'replacement_cleanup_failed', message: 'The new reminder is saved, but the old reminder could not be removed. Refresh the list before retrying.', replacement, originalId }
+    }
+    if (!await this.flush(agent)) return {
+      ok: false, code: 'replacement_cleanup_uncertain',
+      message: 'The new reminder is saved, but removal of the old reminder is not confirmed. Refresh the list before retrying.', replacement, originalId,
+    }
+    this.notify(agent)
+    return { ok: true, item: replacement, replacedId: originalId }
+  }
+
+  private run(agent: Agent, signal: AbortSignal, action: () => Promise<ScheduleMutationResult>): Promise<ScheduleMutationResult> {
+    const operation = runScheduleTransaction(agent, async (): Promise<ScheduleMutationResult> => {
+      const invalid = this.unavailable(agent, signal)
+      if (invalid !== undefined) return invalid
+      try { return await action() } catch {
+        return { ok: false, code: 'internal_error', message: 'The reminder could not be saved. Refresh the list before retrying.' }
+      }
+    })
+    this.pending.add(operation)
+    void operation.then(() => { this.pending.delete(operation) }, () => { this.pending.delete(operation) })
+    return operation
+  }
+
+  private unavailable(agent: Agent, signal: AbortSignal): Failure | undefined {
+    if (signal.aborted) return { ok: false, code: 'cancelled', message: 'The reminder change was cancelled.' }
+    if (this.owner(agent) === undefined) return { ok: false, code: 'schedule_unavailable', message: 'This Session has no active Schedule owner. Reopen the Session while Schedule is enabled.' }
+    return undefined
+  }
+
+  private fold(agent: Agent): ReturnType<typeof foldScheduleEvents> | Failure {
+    try {
+      // oxlint-disable-next-line typescript/no-deprecated -- Schedule's v1 durable fold reads the owned Session suffix.
+      return foldScheduleEvents(agent.session.ownEvents())
+    } catch (error) {
+      if (error instanceof ScheduleLogError) return { ok: false, code: 'corrupt_schedule_log', message: 'The Session reminder log is corrupt.' }
+      throw error
+    }
+  }
+
+  private async flush(agent: Agent): Promise<boolean> {
+    try { await flushSchedulePersistence(this.ctx, agent.session) } catch { return false }
+    this.notify(agent)
+    return true
+  }
+
+  private notify(agent: Agent): void {
+    try { this.owner(agent)?.() } catch (error) {
+      this.ctx.logger.warn(`schedule: management observer failed: ${error instanceof Error ? error.message : String(error)}`)
+    }
+  }
+
+  private uncertain(): Failure {
+    return { ok: false, code: 'persistence_uncertain', message: 'Reminder persistence is not confirmed. Refresh the list before retrying.' }
+  }
+
+  private notFound(): Failure {
+    return { ok: false, code: 'schedule_not_found', message: 'This reminder is no longer active. Refresh the list.' }
+  }
+}
