+/** Read live service ownership in each consumer's isolation scope without retaining runtime objects. */
+function relatePluginEntries(ctx: Context, entries: readonly PluginInventoryEntry[]): PluginInventoryEntry[] {
+  const byId = new Map(entries.map((entry, order) => [String(entry.entryId), { entry, order }]))
+  const relations = new Map<string, Map<string, Set<string>>>()
+  const link = (from: string, to: string, service: string): void => {
+    let peers = relations.get(from)
+    if (peers === undefined) relations.set(from, peers = new Map())
+    let services = peers.get(to)
+    if (services === undefined) peers.set(to, services = new Set())
+    services.add(service)
+  }
+  for (const runtime of ctx.registry.values()) {
+    for (const fiber of runtime.fibers) {
+      if (fiber.uid === null) continue
+      const consumer = ctx.loader.locate(fiber)
+      if (consumer === undefined || !byId.has(consumer)) continue
+      for (const service of Object.keys(fiber.inject)) {
+        // Cordis uses this same scoped lookup when resolving a Fiber's injections.
+        const implementation = fiber.ctx.reflect._getImpl(service, true)
+        if (implementation === undefined) continue
+        const provider = ctx.loader.locate(implementation.fiber)
+        if (provider === undefined || provider === consumer || !byId.has(provider)) continue
+        link(consumer, provider, service)
+        link(provider, consumer, service)
+      }
+    }
+  }
+  return entries.map(entry => {
+    const peers = relations.get(entry.entryId)
+    if (peers === undefined) return entry
+    const relatedPlugins: RelatedPluginEntry[] = [...peers]
+      .sort(([left], [right]) => byId.get(left)!.order - byId.get(right)!.order)
+      .map(([id, services]) => {
+        const target = byId.get(id)!.entry
+        return { entryId: target.entryId, moduleName: target.moduleName, reason: [...services].sort().join(', ') }
+      })
+    return { ...entry, relatedPlugins }
+  })
 }
